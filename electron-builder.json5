{
  appId: "com.funnyplayer.app",
  productName: "FunnyPlayer",
  copyright: "Copyright © 2025",

  // Overrides the description used by electron-builder's rcedit pass,
  // which stamps FileDescription on the .exe — shown in Task Manager and
  // the Windows "Open With" menu. Leaves package.json itself untouched.
  extraMetadata: {
    description: "FunnyPlayer"
  },

  // No code signing certificate — skip signing entirely
  forceCodeSigning: false,

  directories: {
    buildResources: "build",
    output: "release"
  },

  // JS output from electron-vite; node_modules for production deps are added automatically
  files: [
    "out/**/*",
    "!out/**/*.map",
    // ffprobe-static ships binaries for all 3 platforms; exclude the ones not needed on Windows
    "!**/node_modules/ffprobe-static/bin/darwin/**",
    "!**/node_modules/ffprobe-static/bin/linux/**"
  ],

  // Binaries that can't be executed from inside an asar archive
  asarUnpack: [
    "**/node_modules/ffmpeg-static/**",
    "**/node_modules/ffprobe-static/**"
  ],

  // mpv_player.node → resources/mpv_player.node (accessed via process.resourcesPath)
  // icon.ico → resources/icon.ico (used for BrowserWindow taskbar icon)
  // libmpv-2.dll must sit next to mpv_player.node: Node's dlopen uses
  // LOAD_WITH_ALTERED_SEARCH_PATH on Windows, which makes Windows resolve
  // dependent DLLs from the .node's own directory — NOT from the main exe
  // directory. Putting it under extraFiles (next to the exe) only worked
  // incidentally when cwd happened to coincide with the install dir; it
  // broke file-association launches where cwd is the opened file's folder.
  extraResources: [
    { from: "native/build/Release/mpv_player.node", to: "mpv_player.node" },
    { from: "build/icon.ico", to: "icon.ico" },
    { from: "libmpv-2.dll", to: "libmpv-2.dll" }
  ],

  // ──────────────── Windows ────────────────
  win: {
    icon: "build/icon.ico",
    sign: null,
    target: [
      { target: "nsis",     arch: ["x64"] },
      { target: "portable", arch: ["x64"] }
    ],
    fileAssociations: [
      {
        ext: ["mp4", "mkv", "avi", "mov", "wmv", "flv", "webm", "m4v",
              "ts", "mpg", "mpeg", "m2ts", "mts", "divx", "xvid"],
        name: "Video File",
        description: "Open with FunnyPlayer",
        icon: "build/fileicon.ico",
        role: "Viewer"
      }
    ]
  },

  nsis: {
    oneClick: false,
    perMachine: true,
    allowToChangeInstallationDirectory: true,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    installerIcon: "build/icon.ico",
    uninstallerIcon: "build/icon.ico",
    artifactName: "${productName}-${version}-setup.exe"
  },

  portable: {
    artifactName: "${productName}-${version}-portable.exe"
  },

  // ──────────────── Linux ────────────────
  linux: {
    icon: "build/icon.png",   // 512×512 PNG recommended
    category: "AudioVideo",
    target: [
      { target: "AppImage", arch: ["x64"] },
      { target: "deb",      arch: ["x64"] }
    ],
    // AppImage's parser requires each fileAssociation entry to have a single
    // string `ext` (arrays are accepted by Windows NSIS but rejected here).
    // Each extension is paired with its canonical MIME type.
    fileAssociations: [
      { ext: "mp4",  name: "MP4 Video",     mimeType: "video/mp4",         role: "Viewer" },
      { ext: "m4v",  name: "M4V Video",     mimeType: "video/x-m4v",       role: "Viewer" },
      { ext: "mkv",  name: "Matroska Video", mimeType: "video/x-matroska", role: "Viewer" },
      { ext: "webm", name: "WebM Video",    mimeType: "video/webm",        role: "Viewer" },
      { ext: "avi",  name: "AVI Video",     mimeType: "video/x-msvideo",   role: "Viewer" },
      { ext: "mov",  name: "QuickTime Video", mimeType: "video/quicktime", role: "Viewer" },
      { ext: "wmv",  name: "WMV Video",     mimeType: "video/x-ms-wmv",    role: "Viewer" },
      { ext: "flv",  name: "Flash Video",   mimeType: "video/x-flv",       role: "Viewer" },
      { ext: "mpg",  name: "MPEG Video",    mimeType: "video/mpeg",        role: "Viewer" },
      { ext: "mpeg", name: "MPEG Video",    mimeType: "video/mpeg",        role: "Viewer" },
      { ext: "ts",   name: "MPEG-TS Video", mimeType: "video/mp2t",        role: "Viewer" },
      { ext: "m2ts", name: "MPEG-TS Video", mimeType: "video/mp2t",        role: "Viewer" },
      { ext: "mts",  name: "MPEG-TS Video", mimeType: "video/mp2t",        role: "Viewer" }
    ]
  },

  deb: {
    depends: ["libmpv-dev"]
  }
}
