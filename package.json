{
  "name": "funnyplayer",
  "version": "1.1.0",
  "description": "Video player with funscript support",
  "author": "Wartificer",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/wartificer/FunnyPlayer",
  "repository": {
    "type": "git",
    "url": "https://github.com/wartificer/FunnyPlayer.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "package:win": "electron-vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "package:linux": "electron-vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux",
    "generate:mpvlib": "node scripts/generate-mpv-lib.cjs",
    "build:native": "node scripts/generate-mpv-lib.cjs && cmake-js build -d native -G \"Visual Studio 17 2022\" --cmake-path \"C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe\"",
    "rebuild:native": "cmake-js rebuild -d native -G \"Visual Studio 17 2022\" --cmake-path \"C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe\""
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "cmake-js": "^8.0.0",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "node-addon-api": "^8.7.0",
    "typescript": "^6.0.2",
    "vite": "^7.3.2"
  }
}
